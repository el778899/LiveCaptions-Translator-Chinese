<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="快速开始"
    Width="700"
    Height="490"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="27"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <ui:TextBlock Padding="15,0,0,0" VerticalAlignment="Center">
                    快速开始
                </ui:TextBlock>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}">
            <TextBlock
                Margin="20"
                HorizontalAlignment="Left"
                FontSize="24"
                FontWeight="Bold"
                Text="欢迎使用 LiveCaptions 翻译器！"
                TextAlignment="Left" />
            <ui:TextBlock
                Margin="20,10,20,10"
                TextAlignment="Left"
                TextWrapping="Wrap">
                <Run Text="LiveCaptions 翻译器基于 Windows LiveCaptions 实现。" />
                <Run Text="首次使用前，请按照以下步骤完成配置：&#x0A;" />
                <Run Text="&#x0A;1. 打开 Windows LiveCaptions，按照指引下载本地语音识别及语言包所需文件。" />
                <Run Text="&#x0A;2. 在 Windows LiveCaptions 中点击" />
                <Run FontWeight="Bold" Text="⚙️ 齿轮" />
                <Run Text="图标打开设置，并选择" />
                <Run FontWeight="Bold" Text="“位置 &gt; 覆盖屏幕”" />
                <Run Text="。" />
                <Run Text="&#x0A;3. 在 LiveCaptions 翻译器的设置页点击" />
                <Run FontWeight="Bold" Text="“隐藏”" />
                <Run Text="按钮，以隐藏 Windows LiveCaptions。&#x0A;" />
                <Run Text="&#x0A;程序已自动跳转至设置页并打开了 Windows LiveCaptions。" />
                <Run Text="完成上述配置后，即可返回主界面享受实时翻译体验。&#x0A;" />
                <Run Text="&#x0A;了解更多内容请访问我们的 Wiki：" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator/wiki" RequestNavigate="Hyperlink_RequestNavigate">
                    https://github.com/SakiRinn/LiveCaptions-Translator/wiki
                </Hyperlink>
                <Run FontWeight="Bold" Text="&#x0A;&#x0A;提示：" />
                <Run Text="如需调整" />
                <Run FontWeight="DemiBold" TextDecorations="Underline" Text="源语言" />
                <Run Text="，请在设置页临时“显示” LiveCaptions，并在其原生界面中完成修改。" />
            </ui:TextBlock>

            <ui:Button
                Margin="0,10,0,0"
                Padding="30,10,30,10"
                HorizontalAlignment="Center"
                Click="CloseButton_Click"
                Content="我已完成上述配置" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>